{
  "name": "golden-hand-mahjong-pos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite apps/web --host 0.0.0.0",
    "build": "tsc --noEmit && vite build apps/web",
    "preview": "vite preview apps/web --host 0.0.0.0",
    "lint": "eslint .",
    "test": "node --test --test-isolation=none tests/domain.test.mjs tests/devices.test.mjs",
    "test:e2e": "node tests/browser.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && node scripts/build-android.mjs",
    "owner:preview": "npm run build && node scripts/package-owner-preview.mjs",
    "test:owner-preview": "node tests/owner-preview.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "playwright": "1.57.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "7.2.2"
  }
}
